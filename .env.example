# Copy to .env for local testing, or add these as Variables in Railway.
# With nothing set, local form submissions are printed to the terminal.

# Send from josh@secondshiftops.co through a Google Apps Script web app.
# Set up google-apps-script/Code.gs first (see README.md). Works on every Railway plan.
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=

# Where inquiries are delivered (defaults to josh@secondshiftops.co)
CONTACT_TO=josh@secondshiftops.co

# Alternative: SMTP. Railway only allows SMTP on Pro and above.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
