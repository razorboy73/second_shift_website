# Copy to .env for local testing, or add these as Variables in Railway.
# With nothing set, local form submissions are printed to the terminal.

# Recommended: send from your Gmail through a Google Apps Script web app.
# Set up google-apps-script/Code.gs first (see README.md). Works on every Railway plan.
# The recipient is set in the script (CONTACT_TO script property, or your Gmail by default).
GMAIL_SCRIPT_URL=
GMAIL_SCRIPT_SECRET=

# Alternative: SMTP (e.g. Gmail with an app password). Railway only allows SMTP on Pro and above.
CONTACT_TO=joshadamkerbel@gmail.com
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
MAIL_FROM=
