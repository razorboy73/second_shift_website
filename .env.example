# Copy to .env for local testing, or add these as Variables in Railway.

# Where contact form submissions are sent
CONTACT_TO=joshadamkerbel@gmail.com

# Option A (recommended on Railway): Resend, https://resend.com
# Until you verify your own domain, Resend only delivers to the email on your Resend account,
# and MAIL_FROM must stay onboarding@resend.dev.
RESEND_API_KEY=
MAIL_FROM=Second Shift Ops Website <onboarding@resend.dev>

# Option B: any SMTP server (e.g. Gmail with an app password). Note: Railway blocks
# outbound SMTP on some plans, so Resend is the safer choice there.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
